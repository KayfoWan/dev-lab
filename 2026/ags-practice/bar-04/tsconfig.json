  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    // "checkJs": true,
    // "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "paths": {
      "astal/*": ["./.types/astal/*"],
      "astal": ["./.types/astal/index.d.ts"]
    }
  }
}
